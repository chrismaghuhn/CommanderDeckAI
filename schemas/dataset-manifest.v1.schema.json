{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/dataset-manifest.v1.schema.json",
  "title": "Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "created_at",
    "builder_version",
    "ruleset_versions",
    "card_snapshot_ids",
    "source_snapshots",
    "filters",
    "split_policy",
    "tables",
    "counts",
    "quality_report",
    "leakage_report",
    "redistribution_status",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "dataset-manifest.v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "builder_version": {
      "type": "string",
      "minLength": 1
    },
    "code_commit": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "card_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "filters": {
      "type": "object"
    },
    "split_policy": {
      "type": "object"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality_report": {
      "type": "string",
      "minLength": 1
    },
    "leakage_report": {
      "type": "string",
      "minLength": 1
    },
    "redistribution_status": {
      "enum": [
        "local_only",
        "derived_only",
        "redistributable"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

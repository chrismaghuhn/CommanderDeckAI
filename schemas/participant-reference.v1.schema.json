{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/participant-reference.v1.schema.json",
  "title": "Participant Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_id",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "participant-reference.v1"
    },
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "source",
        "event",
        "snapshot_object"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}

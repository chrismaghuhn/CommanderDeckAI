{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/dataset-manifest.v2.schema.json",
  "title": "Dataset Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "producing_run_id",
    "created_at",
    "builder_version",
    "code_commit",
    "dependency_lock_hash",
    "input_manifests",
    "schema_versions",
    "transform_versions",
    "policy_versions",
    "ruleset_versions",
    "card_snapshot_ids",
    "filters",
    "split_policy",
    "exclusions",
    "counts",
    "outputs",
    "redistribution_status",
    "dataset_content_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "dataset-manifest.v2"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_kind": {
      "enum": [
        "deck_completion",
        "tournament_outcomes",
        "card_cooccurrence",
        "combo",
        "unknown"
      ]
    },
    "config_version": {
      "type": "string",
      "minLength": 1
    },
    "producing_run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "builder_version": {
      "type": "string",
      "minLength": 1
    },
    "code_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "dependency_lock_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input_manifest"
      },
      "uniqueItems": true
    },
    "schema_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transform_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ruleset_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "card_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "filters": {
      "type": "object"
    },
    "split_policy": {
      "type": "object"
    },
    "split_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "near_duplicate_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "near_duplicate_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "near_duplicate_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "exclusion_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output_artifact"
      },
      "uniqueItems": true
    },
    "quality_report": {
      "$ref": "#/$defs/output_artifact"
    },
    "leakage_report": {
      "$ref": "#/$defs/output_artifact"
    },
    "random_seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "redistribution_status": {
      "enum": [
        "local_only",
        "derived_only",
        "redistributable"
      ]
    },
    "dataset_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:~[^/]*|<external-root>|<repository-root>)(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$",
          "not": {
            "type": "string",
            "pattern": "\\u0000"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "output_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:~[^/]*|<external-root>|<repository-root>)(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$",
          "not": {
            "type": "string",
            "pattern": "\\u0000"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/source-snapshot-manifest.v1.schema.json",
  "title": "Source Snapshot Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_snapshot_id",
    "status",
    "approval_status",
    "adapter_version",
    "started_at",
    "completed_at",
    "request_parameters_redacted",
    "objects",
    "attribution_required",
    "redistribution_status",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "source-snapshot-manifest.v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "FAILED"
      ]
    },
    "approval_status": {
      "enum": [
        "APPROVED_LOCAL",
        "APPROVED_REDISTRIBUTION"
      ]
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "terms_reference": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "request_parameters_redacted": {
      "type": "object"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_object_id",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "source_object_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "pagination_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "attribution_required": {
      "type": "boolean"
    },
    "redistribution_status": {
      "enum": [
        "not_approved",
        "derived_only",
        "approved"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

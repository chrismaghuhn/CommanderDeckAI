{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/card.v1.schema.json",
  "title": "Canonical Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_snapshot_id",
    "oracle_id",
    "name",
    "normalized_name",
    "layout",
    "mana_value",
    "colors",
    "color_identity",
    "supertypes",
    "types",
    "subtypes",
    "keywords",
    "legalities",
    "copy_limit_policy",
    "is_basic_land",
    "is_token",
    "is_digital",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "card.v1"
    },
    "card_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "normalized_name": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "mana_value": {
      "type": "number",
      "minimum": 0
    },
    "mana_cost": {
      "type": [
        "string",
        "null"
      ]
    },
    "colors": {
      "type": "array",
      "items": {
        "enum": [
          "W",
          "U",
          "B",
          "R",
          "G"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "color_identity": {
      "type": "array",
      "items": {
        "enum": [
          "W",
          "U",
          "B",
          "R",
          "G"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "supertypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "subtypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "oracle_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "power": {
      "type": [
        "string",
        "null"
      ]
    },
    "toughness": {
      "type": [
        "string",
        "null"
      ]
    },
    "loyalty": {
      "type": [
        "string",
        "null"
      ]
    },
    "legalities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "legal",
          "not_legal",
          "banned",
          "restricted",
          "unknown"
        ]
      },
      "required": [
        "commander"
      ]
    },
    "copy_limit_policy": {
      "enum": [
        "default_singleton",
        "unlimited",
        "fixed",
        "rule_derived"
      ]
    },
    "fixed_copy_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "is_basic_land": {
      "type": "boolean"
    },
    "is_token": {
      "type": "boolean"
    },
    "is_digital": {
      "type": "boolean"
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_snapshot_id",
          "source_object_id",
          "raw_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "source_object_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "adapter_version": {
            "type": "string",
            "minLength": 1
          },
          "mapper_version": {
            "type": "string",
            "minLength": 1
          },
          "approval_status": {
            "enum": [
              "APPROVED_LOCAL",
              "APPROVED_REDISTRIBUTION"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/combo-corpus.v1.schema.json",
  "title": "Combo Corpus Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["curated_id", "values", "layer"],
  "properties": {
    "curated_id": {"type": "string", "minLength": 1},
    "layer": {"const": "curated"},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_id", "split", "observed_at", "payload"],
      "properties": {
        "schema_version": {"const": "combo-corpus.v1"},
        "record_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation", "test"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "payload": {"type": "object", "additionalProperties": true}
      }
    }
  }
}

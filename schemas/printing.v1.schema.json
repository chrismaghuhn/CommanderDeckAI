{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/printing.v1.schema.json",
  "title": "Card Printing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "printing_id",
    "oracle_id",
    "card_snapshot_id",
    "set_code",
    "collector_number",
    "released_at",
    "face_ids",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "printing.v1"
    },
    "printing_id": {
      "type": "string",
      "format": "uuid"
    },
    "oracle_id": {
      "type": "string",
      "format": "uuid"
    },
    "card_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "set_code": {
      "type": "string",
      "minLength": 1
    },
    "collector_number": {
      "type": "string",
      "minLength": 1
    },
    "released_at": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "rarity": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "is_foil": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_promo": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "face_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_reference"
      }
    }
  },
  "$defs": {
    "provenance_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_snapshot_id",
        "source_object_id",
        "raw_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_object_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "adapter_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mapper_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "approval_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "APPROVED_LOCAL",
            "APPROVED_REDISTRIBUTION",
            null
          ]
        }
      }
    }
  }
}

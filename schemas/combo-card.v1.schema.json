{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/combo-card.v1.schema.json",
  "title": "Combo Card Fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "combo_id",
    "oracle_id",
    "role",
    "quantity",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "combo-card.v1"
    },
    "combo_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "required",
        "optional",
        "commander",
        "enabler",
        "result"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_reference"
      }
    }
  },
  "$defs": {
    "provenance_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_snapshot_id",
        "source_object_id",
        "raw_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_object_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "mapper_version": {
          "type": "string",
          "minLength": 1
        },
        "approval_status": {
          "enum": [
            "APPROVED_LOCAL",
            "APPROVED_REDISTRIBUTION"
          ]
        }
      }
    }
  }
}

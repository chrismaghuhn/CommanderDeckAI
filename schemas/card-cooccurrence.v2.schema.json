{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/card-cooccurrence.v2.schema.json",
  "title": "Card Co-occurrence Row v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["curated_id", "values", "layer"],
  "properties": {
    "curated_id": {"type": "string", "minLength": 1},
    "layer": {"const": "curated"},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_id", "split", "canonical_deck_id", "source_id",
        "source_deck_id", "source_snapshot_id", "observed_at", "group_ids",
        "command_zone", "card_zones", "relation_type", "left_id", "right_id"
      ],
      "properties": {
        "schema_version": {"const": "card-cooccurrence.v2"},
        "record_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation", "test"]},
        "canonical_deck_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_deck_id": {"type": "string", "minLength": 1},
        "source_snapshot_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "group_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "command_zone": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/command_zone_entry"}
        },
        "card_zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/card_zone"}
        },
        "relation_type": {"enum": ["commander_card", "card_card"]},
        "left_id": {"type": "string", "format": "uuid"},
        "right_id": {"type": "string", "format": "uuid"}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "card_quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "quantity"],
      "properties": {
        "oracle_id": {"$ref": "#/$defs/uuid"},
        "quantity": {"type": "integer", "minimum": 1},
        "printing_id": {
          "anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
        }
      }
    },
    "command_zone_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "quantity"],
      "properties": {
        "oracle_id": {"$ref": "#/$defs/uuid"},
        "quantity": {"type": "integer", "minimum": 1},
        "printing_id": {
          "anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
        },
        "source_declared_role": {
          "anyOf": [
            {"enum": ["commander", "partner", "background", "companion", "unknown"]},
            {"type": "null"}
          ]
        }
      }
    },
    "card_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "cards"],
      "properties": {
        "zone": {"type": "string", "minLength": 1, "not": {"const": "command_zone"}},
        "cards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/card_quantity"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/event-deck-observation.v1.schema.json",
  "title": "Event Deck Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "event_id",
    "canonical_deck_id",
    "observed_at",
    "participant_reference_scope",
    "final_placement",
    "aggregate_wins",
    "aggregate_losses",
    "aggregate_draws",
    "source_result_semantics",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "event-deck-observation.v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_deck_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "participant_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/participant_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "participant_reference_scope": {
      "enum": [
        "source",
        "event",
        "snapshot_object",
        "none"
      ]
    },
    "final_placement": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "aggregate_wins": {
      "type": "integer",
      "minimum": 0
    },
    "aggregate_losses": {
      "type": "integer",
      "minimum": 0
    },
    "aggregate_draws": {
      "type": "integer",
      "minimum": 0
    },
    "source_result_semantics": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_reference"
      }
    }
  },
  "$defs": {
    "participant_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reference_id",
        "scope"
      ],
      "properties": {
        "schema_version": {
          "const": "participant-reference.v1"
        },
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "source",
            "event",
            "snapshot_object"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "scope": {
              "const": "source"
            },
            "source_id": {
              "type": "string"
            },
            "event_id": {
              "type": "null"
            },
            "source_snapshot_id": {
              "type": "null"
            }
          },
          "required": [
            "source_id",
            "event_id",
            "source_snapshot_id"
          ]
        },
        {
          "properties": {
            "scope": {
              "const": "event"
            },
            "source_id": {
              "type": "null"
            },
            "event_id": {
              "type": "string"
            },
            "source_snapshot_id": {
              "type": "null"
            }
          },
          "required": [
            "source_id",
            "event_id",
            "source_snapshot_id"
          ]
        },
        {
          "properties": {
            "scope": {
              "const": "snapshot_object"
            },
            "event_id": {
              "type": "null"
            },
            "source_snapshot_id": {
              "type": "string"
            }
          },
          "required": [
            "event_id",
            "source_snapshot_id"
          ]
        }
      ]
    },
    "provenance_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_snapshot_id",
        "source_object_id",
        "raw_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_object_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "mapper_version": {
          "type": "string",
          "minLength": 1
        },
        "approval_status": {
          "enum": [
            "APPROVED_LOCAL",
            "APPROVED_REDISTRIBUTION"
          ]
        }
      }
    }
  }
}

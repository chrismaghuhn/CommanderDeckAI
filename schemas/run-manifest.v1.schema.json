{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commander-deck-ai/schemas/run-manifest.v1.schema.json",
  "title": "Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_kind",
    "stage",
    "status",
    "created_at",
    "git_commit",
    "git_dirty",
    "inputs",
    "configuration",
    "determinism",
    "random_seeds",
    "environment",
    "artifacts",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "run-manifest.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_kind": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "created",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "git_worktree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "uniqueItems": true
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "feature_spec_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ruleset_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "determinism": {
      "enum": [
        "STRICT",
        "BEST_EFFORT",
        "EXTERNAL"
      ]
    },
    "random_seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "platform",
        "dependency_lock_hash",
        "tools"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "accelerator": {
              "type": "string",
              "minLength": 1
            },
            "thread_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "checkpoint_selection_rule": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "created"
          }
        }
      },
      "then": {
        "properties": {
          "started_at": false,
          "finished_at": false
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "required": [
          "started_at"
        ],
        "properties": {
          "finished_at": false
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "started_at",
          "finished_at"
        ]
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "required": [
          "finished_at"
        ]
      }
    },
    {
      "if": {
        "required": [
          "git_dirty"
        ],
        "properties": {
          "git_dirty": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "git_worktree_sha256"
        ],
        "properties": {
          "artifacts": {
            "contains": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "git_worktree_state"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "git_dirty"
        ],
        "properties": {
          "git_dirty": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "git_worktree_sha256": false
        }
      }
    },
    {
      "if": {
        "required": [
          "determinism"
        ],
        "properties": {
          "determinism": {
            "const": "STRICT"
          }
        }
      },
      "then": {
        "properties": {
          "git_dirty": {
            "const": false
          }
        }
      }
    }
  ]
}
